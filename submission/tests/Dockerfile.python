FROM python:3.13-slim@sha256:3dd7cc108ec1493442514f5c2a871af6af0ec31d768ff6e378a93340c3b3db5f
RUN pip install --no-cache-dir 'mailchannels[async]==1.5.0' httpx==0.28.1 pytest==9.1.1
WORKDIR /tests
COPY test_python_recipes.py /tests/test_python_recipes.py
CMD ["python", "-m", "pytest", "-q", "test_python_recipes.py"]
